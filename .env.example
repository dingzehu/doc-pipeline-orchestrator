# Copy this file to .env and fill in real values. Never commit .env.

# ── Django ────────────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True

# ── Shared PostgreSQL ─────────────────────────────────────────────────────────
# One container, three databases. POSTGRES_DB is Django's database.
# pdf_extractions and arxiv are created by docker-entrypoint-initdb.d/init.sql
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=orchestrator
DATABASE_URL=postgresql://postgres:password@db:5432/orchestrator

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Gemini (shared by all three services) ────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── pdf-extraction-service database URL ──────────────────────────────────────
PDF_SERVICE_DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/pdf_extractions

# ── rag-search-service database URL ──────────────────────────────────────────
RAG_SERVICE_DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/arxiv

# ── MLflow (used by rag-search-service) ──────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Upstream service URLs (used by Celery worker) ────────────────────────────
PDF_EXTRACTION_SERVICE_URL=http://pdf-extraction-service:8000
RAG_SEARCH_SERVICE_URL=http://rag-search-service:8000

# ── LocalStack (Terraform + S3) ────────────────────────────────────
LOCALSTACK_AUTH_TOKEN=your-localstack-auth-token-here
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_S3_ENDPOINT_URL=http://localstack:4566

# —— AWS STORAGE BUCKET ———————————————————————————————————————————————————————
AWS_STORAGE_BUCKET_NAME=doc-pipeline-pdfs